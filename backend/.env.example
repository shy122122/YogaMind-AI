# OpenAI 官方或兼容 OpenAI 格式服务的配置
# OpenAI 官方:
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# DeepSeek 示例:
# OPENAI_BASE_URL=https://api.deepseek.com
#
# Qwen / DashScope 兼容模式示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM 超时时间，单位：秒
LLM_TIMEOUT_SECONDS=5

# 日志等级：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 本地与手机联调跨域白名单正则。
# 默认允许 http://localhost:*、http://127.0.0.1:* 以及常见局域网 IP。
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$
